- name: epy_block_4
  id: epy_block
  parameters:
    I: I_RS
    _source_code: "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nCCSDS\
      \ RS(255,223) encoder + symbol interleaver (depth I), TX side.\n\nIn  : BYTES\
      \ (uint8) tagged stream, len_tag_key = 223*I (already randomized)\nOut0: BYTES\
      \ (uint8) tagged stream, len_tag_key = 255*I (I interleaved RS codewords)\n\
      Out1: FLOAT (float32) tap (same item count as Out0) for plotting/probing\n\n\
      Interleaver: de-mux 223*I \u2192 I branches of 223 (round-robin), RS(255,223)\
      \ each,\n             then symbol-interleave column-wise: cw0[0],cw1[0],...,cw{I-1}[0],cw0[1],...\n\
      \"\"\"\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, len_tag_key=\"packet_len\", I=5, tm_len=1115):\n   \
      \     gr.basic_block.__init__(\n            self,\n            name=\"rs255_223_encode_interleave_I\"\
      ,\n            in_sig=[np.uint8],\n            out_sig=[np.uint8, np.float32],\
      \   # \u2705 stream outputs as dtypes\n        )\n\n        # ---- Params ----\n\
      \        self.len_key = pmt.intern(str(len_tag_key))\n        self.I = int(I)\n\
      \        self.tm_len = int(tm_len)  # must be 223*I\n\n        # ---- RS(255,223)\
      \ constants ----\n        self.N  = 255\n        self.K  = 223\n        self.NP\
      \ = self.N - self.K  # 32 parity bytes\n\n        if self.tm_len != self.K *\
      \ self.I:\n            raise ValueError(f\"tm_len ({self.tm_len}) must equal\
      \ 223*I ({self.K*self.I})\")\n\n        # ---- GF(256) tables, primitive poly\
      \ 0x11D ----\n        self._gf_init(prim=0x11D)\n        # g(x) = \u220F_{i=1..32}\
      \ (x \u2212 \u03B1^i)\n        self.gen = self._rs_generator(self.NP)\n\n  \
      \      # forward non-length tags from input to output frame head\n        self._forward_all_tags\
      \ = True\n\n    # ---------------- GF(256) helpers ----------------\n    def\
      \ _gf_init(self, prim=0x11D):\n        self.gf_exp = np.zeros(512, dtype=np.uint8)\n\
      \        self.gf_log = np.full(256, -1, dtype=np.int16)\n        x = 1\n   \
      \     for i in range(255):\n            self.gf_exp[i] = x\n            self.gf_log[x]\
      \ = i\n            x <<= 1\n            if x & 0x100:\n                x ^=\
      \ prim\n        # duplicate for fast wrap\n        self.gf_exp[255:510] = self.gf_exp[:255]\n\
      \        self.gf_exp[510:]    = self.gf_exp[:2]\n\n    @staticmethod\n    def\
      \ _gf_add(a, b):  # = subtract\n        return a ^ b\n\n    def _gf_mul(self,\
      \ a, b):\n        if a == 0 or b == 0:\n            return 0\n        return\
      \ int(self.gf_exp[int(self.gf_log[a]) + int(self.gf_log[b])])\n\n    def _poly_mul(self,\
      \ p, q):\n        r = np.zeros(len(p) + len(q) - 1, dtype=np.uint8)\n      \
      \  for i, a in enumerate(p):\n            if a == 0: continue\n            ai\
      \ = int(a)\n            for j, b in enumerate(q):\n                if b == 0:\
      \ continue\n                r[i + j] ^= self._gf_mul(ai, int(b))\n        return\
      \ r\n\n    def _rs_generator(self, nsym):\n        g = np.array([1], dtype=np.uint8)\n\
      \        for i in range(1, nsym + 1):\n            g = self._poly_mul(g, np.array([1,\
      \ self.gf_exp[i]], dtype=np.uint8))\n        return g  # length nsym+1\n\n \
      \   def _rs_encode_223_255(self, data):\n        \"\"\"Return 32-byte parity\
      \ for a 223-byte message (systematic RS).\"\"\"\n        if len(data) != self.K:\n\
      \            raise ValueError(\"RS encoder expects exactly 223 data bytes\"\
      )\n        rem = np.zeros(self.NP, dtype=np.uint8)\n        # LFSR-style division:\
      \ remainder of x^NP * data(x) by g(x)\n        for d in data:\n            coef\
      \ = d ^ rem[0]\n            rem = np.concatenate([rem[1:], np.array([0], dtype=np.uint8)])\n\
      \            if coef != 0:\n                for j in range(self.NP):\n     \
      \               rem[j] ^= self._gf_mul(int(self.gen[j + 1]), int(coef))\n  \
      \      return bytes(rem)  # 32B parity\n\n    # ----------------- Helpers -----------------\n\
      \    def _demux_round_robin(self, tm_bytes):\n        \"\"\"Split 223*I into\
      \ I branches of 223 bytes: j, j+I, j+2I, ...\"\"\"\n        branches = []\n\
      \        for j in range(self.I):\n            branch = tm_bytes[j::self.I]\n\
      \            if len(branch) != self.K:\n                branch = np.pad(branch,\
      \ (0, self.K - len(branch)), constant_values=0)\n            branches.append(np.array(branch,\
      \ dtype=np.uint8))\n        return branches\n\n    def _interleave_symbols(self,\
      \ codewords):\n        \"\"\"codewords: list of I arrays (len 255). Output:\
      \ cw0[0],cw1[0],...,cw{I-1}[0], cw0[1],...\"\"\"\n        out = np.empty(self.N\
      \ * self.I, dtype=np.uint8)\n        idx = 0\n        for s in range(self.N):\n\
      \            for j in range(self.I):\n                out[idx] = codewords[j][s]\n\
      \                idx += 1\n        return out\n\n    def _emit_tap(self, n_out):\n\
      \        \"\"\"\n        Float32 marker vector (same length as byte output):\n\
      \          - 1.0 at frame start (index 0)\n          - 0.5 at each 255-symbol\
      \ boundary (indices 255-1, 2*255-1, ...)\n          - 0.0 elsewhere\n      \
      \  \"\"\"\n        tap = np.zeros(n_out, dtype=np.float32)\n        tap[0] =\
      \ 1.0\n        for k in range(255, n_out + 1, 255):\n            if k - 1 <\
      \ n_out:\n                tap[k - 1] = 0.5\n        return tap\n\n    # -----------------\
      \ Work -----------------\n    def general_work(self, input_items, output_items):\n\
      \        inp   = input_items[0]\n        out_b = output_items[0]  # bytes\n\
      \        out_f = output_items[1]  # floats\n\n        n_in    = len(inp)\n \
      \       n_out_b = len(out_b)\n        n_out_f = len(out_f)\n\n        if n_in\
      \ == 0 or n_out_b == 0 or n_out_f == 0:\n            return 0\n\n        n_read\
      \ = self.nitems_read(0)\n        tags   = self.get_tags_in_window(0, 0, n_in)\n\
      \n        # find the first len_tag at/within the current window head\n     \
      \   frame_tag = None\n        for t in tags:\n            if t.key == self.len_key:\n\
      \                rel = int(t.offset - n_read)\n                if rel <= 0:\n\
      \                    frame_tag = (t, rel)\n                    break\n     \
      \   if frame_tag is None:\n            return 0\n\n        t, rel = frame_tag\n\
      \        if rel < 0:\n            to_consume = min(-rel, n_in)\n           \
      \ self.consume(0, to_consume)\n            return 0\n\n        # need full frame\
      \ in window\n        if n_in < self.tm_len:\n            return 0\n\n      \
      \  out_len = self.N * self.I  # 255*I\n        if n_out_b < out_len or n_out_f\
      \ < out_len:\n            return 0\n\n        # slice exactly one TM frame\n\
      \        tm = np.array(inp[:self.tm_len], dtype=np.uint8)\n\n        # de-mux\
      \ \u2192 RS encode per branch \u2192 collect codewords\n        branches  =\
      \ self._demux_round_robin(tm)\n        codewords = []\n        for j in range(self.I):\n\
      \            parity = self._rs_encode_223_255(branches[j])\n            cw \
      \    = np.concatenate([branches[j], np.frombuffer(parity, dtype=np.uint8)])\
      \  # 223+32\n            codewords.append(cw)\n\n        # interleave symbols\
      \ \u2192 out0\n        inter = self._interleave_symbols(codewords)\n       \
      \ out_b[:out_len] = inter\n\n        # float tap \u2192 out1\n        out_f[:out_len]\
      \ = self._emit_tap(out_len)\n\n        # emit new len tag on output 0 (bytes)\n\
      \        self.add_item_tag(0, self.nitems_written(0), self.len_key, pmt.from_long(out_len))\n\
      \n        # forward non-length tags to output 0 at frame head (optional)\n \
      \       if self._forward_all_tags:\n            for tg in tags:\n          \
      \      if tg.key == self.len_key:\n                    continue\n          \
      \      self.add_item_tag(0, self.nitems_written(0), tg.key, tg.value)\n\n  \
      \      # consume one input frame\n        self.consume(0, self.tm_len)\n   \
      \     # produce out_len items on BOTH outputs (same rate)\n        return out_len\n\
      \n"
    affinity: ''
    alias: rs_I
    comment: ''
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    tm_len: BYTES_PER_TM_FRAME
  states:
    _io_cache: ('rs255_223_encode_interleave_I', 'blk', [('len_tag_key', "'packet_len'"),
      ('I', '5'), ('tm_len', '1115')], [('0', 'byte', 1)], [('0', 'byte', 1), ('1',
      'float', 1)], '', ['I', 'tm_len'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1724.0, 728]
    rotation: 270
    state: enabled
- name: epy_block_5
  id: epy_block
  parameters:
    _source_code: "import numpy as np, pmt\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, len_tag_key=\"packet_len\"):\n        gr.basic_block.__init__(self,\
      \ name=\"len_meter_ts\",\n                                in_sig=[np.uint8],\
      \ out_sig=[np.float32])\n        self.len_key = pmt.intern(len_tag_key)\n\n\
      \    def general_work(self, input_items, output_items):\n        inp, out =\
      \ input_items[0], output_items[0]\n        n = len(inp)\n        if n == 0 or\
      \ len(out) == 0:\n            return 0\n        n_read = self.nitems_read(0)\n\
      \        tags = self.get_tags_in_window(0, 0, n, self.len_key)\n        if not\
      \ tags:\n            return 0\n        t = tags[0]\n        rel = int(t.offset\
      \ - n_read)\n        if rel > 0:\n            self.consume(0, rel); \n     \
      \       return 0\n        L = int(pmt.to_long(t.value))\n        if n < L: \
      \ # wait for full frame in this window\n            return 0\n        out[0]\
      \ = float(L)\n        self.consume(0, L)   # advance exactly one frame\n   \
      \     return 1\n"
    affinity: ''
    alias: len_tm
    comment: ''
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
